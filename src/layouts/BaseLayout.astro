---
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "HWP 뷰어 및 정보 가이드", 
  description = "웹 브라우저에서 빠르게 한글(HWP) 문서를 확인하고 다양한 인기 순위와 가이드를 만나보세요." 
} = Astro.props;

const siteTitle = title.includes("HWP") ? title : `${title} | HWP 뷰어`;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />

    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="site-logo">📄 HWP 뷰어</a>
        <nav class="site-nav">
          <a href="/rank/">인기 순위</a>
          <a href="/guide/">가이드</a>
        </nav>
      </div>
    </header>

    <main class="main-container">
      <slot />
    </main>

    <!-- 하단 푸터 (회사소개, 개인정보처리방침, 고객센터 링크 추가됨) -->
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-links">
          <a href="/about/">회사소개</a>
          <span class="divider">|</span>
          <a href="/privacy/">개인정보처리방침</a>
          <span class="divider">|</span>
          <a href="/contact/">고객센터</a>
        </div>
        <p class="copyright">&copy; {new Date().getFullYear()} HWP Viewer. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
    background-color: #f8fafc;
    color: #0f172a;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-logo {
    font-size: 1.25rem;
    font-weight: 800;
    color: #2563eb;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 20px;
  }

  .site-nav a {
    text-decoration: none;
    color: #475569;
    font-size: 0.98rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .site-nav a:hover {
    color: #2563eb;
  }

  .main-container {
    flex: 1;
    width: 100%;
    max-width: 1024px;
    margin: 24px auto;
    padding: 28px 32px;
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }

  /* 하단 푸터 및 링크 스타일 */
  .site-footer {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 24px 20px;
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .footer-links a {
    color: #64748b;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #2563eb;
    text-decoration: underline;
  }

  .footer-links .divider {
    color: #cbd5e1;
    font-size: 0.8rem;
  }

  .copyright {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
  }

  /* 📱 모바일 화면 최적화 (768px 이하) */
  @media (max-width: 768px) {
    .main-container {
      margin: 0 auto;
      border-radius: 0;
      border-left: none;
      border-right: none;
      padding: 18px 12px;
    }

    .header-container {
      padding: 12px 16px;
    }

    .site-logo {
      font-size: 1.15rem;
    }
  }
</style>
