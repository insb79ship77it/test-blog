---
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "HWP 뷰어 및 정보 가이드", 
  description = "웹 브라우저에서 빠르게 한글(HWP) 문서를 확인하고 다양한 인기 순위와 가이드를 만나보세요." 
} = Astro.props;

const siteTitle = title.includes("HWP") ? title : `${title} | HWP 뷰어`;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO 기본 메타 태그 -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph (카카오톡, 검색엔진 수집용) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />

    <!-- 전역 폰트 설정 -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  </head>
  <body>
    <!-- 상단 네비게이션 헤더 -->
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="site-logo">📄 HWP 뷰어</a>
        <nav class="site-nav">
          <a href="/rank/">인기 순위</a>
          <a href="/guide/">가이드</a>
        </nav>
      </div>
    </header>

    <!-- 메인 본문 영역 (모바일 반응형 최적화) -->
    <main class="main-container">
      <slot />
    </main>

    <!-- 하단 푸터 -->
    <footer class="site-footer">
      <div class="footer-container">
        <p>&copy; {new Date().getFullYear()} HWP Viewer. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* 레이아웃 기본 구조 */
  body {
    margin: 0;
    padding: 0;
    font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
    background-color: #f9fafb;
    color: #111827;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* 상단 헤더 */
  .site-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-logo {
    font-size: 1.2rem;
    font-weight: 800;
    color: #2563eb;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 16px;
  }

  .site-nav a {
    text-decoration: none;
    color: #4b5563;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .site-nav a:hover {
    color: #2563eb;
  }

  /* 메인 콘텐츠 컨테이너 */
  .main-container {
    flex: 1;
    width: 100%;
    max-width: 860px;
    margin: 24px auto;
    padding: 24px;
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    box-sizing: border-box;
  }

  /* 하단 푸터 */
  .site-footer {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
    margin-top: auto;
  }

  .footer-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    text-align: center;
    color: #9ca3af;
    font-size: 0.85rem;
  }

  /* 📱 모바일 화면 최적화 (768px 이하) */
  @media (max-width: 768px) {
    .main-container {
      margin: 0 auto;
      border-radius: 0;
      border-left: none;
      border-right: none;
      padding: 16px 14px;
    }

    .header-container {
      padding: 12px 16px;
    }

    .site-logo {
      font-size: 1.1rem;
    }

    .site-nav a {
      font-size: 0.9rem;
    }
  }
</style>
