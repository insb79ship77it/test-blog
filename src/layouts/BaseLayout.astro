---
import '../styles/global.css';
const { title = "온라인 HWP 뷰어" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="container">
      <header>
        <nav>
          <a href="/">HWP 뷰어</a>
          <a href="/rank/">순위</a>
          <a href="/guide/">가이드</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <hr />
        <div class="footer-links">
          <a href="/about/">사이트 소개</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/contact/">문의</a>
        </div>
        <p class="copyright">&copy; 2026 HWP Viewer. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-footer {
    margin-top: 60px;
    padding-bottom: 40px;
    text-align: center;
  }
  .site-footer hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin-bottom: 24px;
  }
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 12px;
  }
  .footer-links a {
    color: #6b7280;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .footer-links a:hover {
    color: #2563eb;
    text-decoration: underline;
  }
  .copyright {
    color: #9ca3af;
    font-size: 0.8rem;
  }
</style>
