---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const rankEntries = await getCollection('rank');
  return rankEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article-container">
    <header class="article-header">
      {entry.data.category && <span class="category-badge">{entry.data.category}</span>}
      <h1 class="article-title">{entry.data.title}</h1>
      {entry.data.description && <p class="article-desc">{entry.data.description}</p>}
    </header>
    <hr class="divider" />
    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    width: 100%;
    border: none; /* 안쪽 테두리 완전 제거 */
    padding: 0;
  }

  .article-header {
    margin-bottom: 20px;
  }

  .category-badge {
    background-color: #eff6ff;
    color: #2563eb;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 12px;
  }

  .article-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.35;
    margin: 0 0 10px 0;
  }

  .article-desc {
    color: #475569;
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.6;
  }

  .divider {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 20px 0 28px 0;
  }

  .article-content {
    line-height: 1.75;
    color: #1e293b;
    font-size: 1.02rem;
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 1.5rem;
    }
  }
</style>
