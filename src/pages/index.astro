---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guide');
---

<BaseLayout title="한글파일, 설치 없이 온라인에서 연다">
  <div class="tool-header">
    <h1>한글파일, 설치 없이 온라인에서 연다</h1>
    <p>맥북·아이폰·안드로이드에서 hwp 파일이 그대로 열립니다.</p>
  </div>

  <!-- 드롭존 업로드 박스 -->
  <div id="drop-zone" class="drop-zone">
    <div class="drop-zone-title">여기에 한글 파일을 끌어다 놓으세요</div>
    <div class="drop-zone-sub">또는 눌러서 선택 · .hwp / .hwpx · 용량 제한 없음</div>
  </div>

  <!-- 가이드 블로그 링크 목록 -->
  <section class="guide-section">
    <h2>가이드</h2>
    <ul class="guide-list">
      {allGuides.map(post => (
        <li>
          <a href={`/guide/${post.slug}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
