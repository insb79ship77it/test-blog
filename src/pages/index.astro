---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allRanks = await getCollection('rank');
const ranks = allRanks.sort((a, b) => new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime()).slice(0, 3);

const allGuides = await getCollection('guide');
const guides = allGuides.sort((a, b) => new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime()).slice(0, 3);

const formatDate = (dateStr) => {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\. /g, '.').replace(/\.$/, '');
};
---

<BaseLayout title="HWP 뷰어 & 인기 순위 가이드" description="웹 브라우저에서 한글 문서를 열람하고 인기 순위 및 가이드 정보를 빠르게 확인하세요.">
  <section class="hero-section">
    <h1>웹 브라우저 HWP 뷰어</h1>
    <p>설치 없이 브라우저에서 한글(HWP, HWPX) 문서를 바로 확인하세요.</p>
  </section>

  <!-- 🔥 인기 순위 섹션 -->
  <section class="section-block">
    <div class="section-header">
      <h2>🔥 인기 순위</h2>
      <a href="/rank/" class="more-link">전체보기 <span class="arrow">→</span></a>
    </div>

    <ul class="clean-list">
      {ranks.map(post => (
        <li class="clean-item">
          <a href={`/rank/${post.slug}/`} class="clean-link">
            <div class="item-meta">
              {post.data.category && <span class="badge">{post.data.category}</span>}
              {post.data.pubDate && <time>{formatDate(post.data.pubDate)}</time>}
            </div>
            <h3 class="item-title">{post.data.title}</h3>
            {post.data.description && <p class="item-desc">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 📚 가이드 & 팁 섹션 -->
  <section class="section-block">
    <div class="section-header">
      <h2>📚 가이드 & 팁</h2>
      <a href="/guide/" class="more-link">전체보기 <span class="arrow">→</span></a>
    </div>

    <ul class="clean-list">
      {guides.map(post => (
        <li class="clean-item">
          <a href={`/guide/${post.slug}/`} class="clean-link">
            <div class="item-meta">
              {post.data.category && <span class="badge badge-guide">{post.data.category}</span>}
              {post.data.pubDate && <time>{formatDate(post.data.pubDate)}</time>}
            </div>
            <h3 class="item-title">{post.data.title}</h3>
            {post.data.description && <p class="item-desc">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 32px 16px;
    margin-bottom: 32px;
    background-color: #f8fafc;
    border-radius: 16px;
  }

  .hero-section h1 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .hero-section p {
    color: #475569;
    font-size: 1rem;
    margin: 0;
  }

  .section-block {
    margin-bottom: 40px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 2px solid #0f172a;
    margin-bottom: 8px;
  }

  .section-header h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  /* 세련된 전체보기 버튼 링크 */
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #2563eb;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 20px;
    background-color: #eff6ff;
    transition: all 0.2s ease;
  }

  .more-link:hover {
    background-color: #dbeafe;
    transform: translateX(2px);
  }

  .more-link .arrow {
    transition: transform 0.2s ease;
  }

  .more-link:hover .arrow {
    transform: translateX(3px);
  }

  /* 목록 이중 테두리 완전 제거 스타일 */
  .clean-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .clean-item {
    border-bottom: 1px solid #f1f5f9;
  }

  .clean-item:last-child {
    border-bottom: none;
  }

  .clean-link {
    display: block;
    padding: 16px 8px;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    transition: background-color 0.15s ease;
  }

  .clean-link:hover {
    background-color: #f8fafc;
  }

  .item-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .badge {
    background-color: #eff6ff;
    color: #2563eb;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .badge-guide {
    background-color: #f0fdf4;
    color: #16a34a;
  }

  .item-meta time {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .item-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 6px 0;
    line-height: 1.4;
  }

  .item-desc {
    font-size: 0.9rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .clean-link {
      padding: 14px 4px;
    }
    
    .hero-section {
      padding: 24px 12px;
      border-radius: 12px;
    }

    .hero-section h1 {
      font-size: 1.5rem;
    }
  }
</style>
