---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// rank 콘텐츠 컬렉션 불러오기
const allRanks = await getCollection('rank');

// 최신순 정렬
const ranks = allRanks.sort(
  (a, b) => new Date(b.data.pubDate || 0).getTime() - new Date(a.data.pubDate || 0).getTime()
);

const formatDate = (dateStr) => {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('ko-KR', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).replace(/\. /g, '.').replace(/\.$/, '');
};
---

<BaseLayout 
  title="인기 순위 TOP 모음" 
  description="다양한 분야의 인기 순위 정보와 분석 데이터를 확인해 보세요."
>
  <div class="page-header">
    <h1>🏆 인기 순위 TOP</h1>
    <p>분야별 인기 순위 및 리스트를 확인해 보세요.</p>
  </div>

  <ul class="card-list">
    {ranks.map(post => (
      <li class="card-item">
        <a href={`/rank/${post.slug}/`} class="card-link">
          <div class="card-meta">
            {post.data.category && <span class="badge">{post.data.category}</span>}
            {post.data.pubDate && <time>{formatDate(post.data.pubDate)}</time>}
          </div>
          <h2 class="card-title">{post.data.title}</h2>
          {post.data.description && <p class="card-desc">{post.data.description}</p>}
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid #111827;
  }

  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
  }

  .page-header p {
    color: #6b7280;
    font-size: 0.95rem;
    margin: 0;
  }

  .card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* 이중 테두리 제거: 박스 테두리 대신 가벼운 하단 구분선 적용 */
  .card-item {
    border: none;
    border-bottom: 1px solid #f3f4f6;
    background-color: transparent;
    transition: background-color 0.15s ease;
  }

  .card-item:last-child {
    border-bottom: none;
  }

  .card-item:hover {
    background-color: #f8fafc;
    border-radius: 8px;
  }

  .card-link {
    display: block;
    padding: 16px 8px;
    text-decoration: none;
    color: inherit;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .badge {
    background-color: #eff6ff;
    color: #2563eb;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 12px;
    border: 1px solid #bfdbfe;
  }

  .card-meta time {
    font-size: 0.85rem;
    color: #9ca3af;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .card-desc {
    font-size: 0.9rem;
    color: #4b5563;
    margin: 0;
    line-height: 1.5;
  }
</style>
