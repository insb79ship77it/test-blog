---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const rankEntries = await getCollection('rank');
  return rankEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <div class="article-header">
      {entry.data.category && <span class="category-badge">{entry.data.category}</span>}
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
    </div>
    <hr />
    <Content />
  </article>
</BaseLayout>

<style>
  .article-header { margin-bottom: 20px; }
  .desc { color: #4b5563; font-size: 1.05rem; margin-top: 12px; line-height: 1.6; }
  .category-badge {
    background-color: #eff6ff;
    color: #2563eb;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid #bfdbfe;
    display: inline-block;
  }
</style>
